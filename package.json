{
  "name": "@outscoreagent/custom-api",
  "version": "0.2.0",
  "description": "Reference SDK for receiving published articles from the OutscoreAgent platform on any Node.js backend (no CMS required).",
  "license": "MIT",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "test": "jest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm test && npm run build"
  },
  "peerDependencies": {
    "express": "^4 || ^5",
    "fastify": "^4 || ^5"
  },
  "peerDependenciesMeta": {
    "express": { "optional": true },
    "fastify": { "optional": true }
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "express": "^4.19.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.5"
  },
  "keywords": [
    "outscoreagent",
    "cms",
    "publishing",
    "sdk",
    "headless",
    "webhook"
  ],
  "publishConfig": {
    "access": "public"
  }
}
